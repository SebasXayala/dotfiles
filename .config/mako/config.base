# ===== Estructura de mako: EDITA ESTE ARCHIVO =====
# Colores, transparencia y formato salen de palette.sh al ejecutar apply.sh
# (no edites ~/.config/mako/config, se sobrescribe)
font=Noto Sans 11
width=380
height=160
margin=14
padding=14,16
border-size=0
border-radius=16
icons=1
max-icon-size=40
icon-location=left
icon-path=/usr/share/icons/WhiteSur-dark:/usr/share/icons/WhiteSur
markup=1
text-alignment=left
max-visible=4
layer=overlay
anchor=top-right
default-timeout=3000
