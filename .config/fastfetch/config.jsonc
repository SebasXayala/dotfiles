{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "cyan", "2": "blue", "3": "white", "4": "yellow" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": { "separator": "   " },
  "modules": [
    "break",
    { "type": "custom", "format": "{#cyan} ___ _  _   _   ___ {#white} _      _   ___ ___" },
    { "type": "custom", "format": "{#cyan}/ __| \\| | /_\\ | _ \\{#white}| |    /_\\ | _ ) __|" },
    { "type": "custom", "format": "{#cyan}\\__ \\ .` |/ _ \\|  _/{#white}| |__ / _ \\| _ \\__ \\" },
    { "type": "custom", "format": "{#cyan}|___/_|\\_/_/ \\_\\_|  {#white}|____/_/ \\_\\___/___/" },
    { "type": "custom", "format": "{#blue}  software · consultoria · desarrollo" },
    "break",
    { "type": "cpu",    "key": "  Procesador", "keyColor": "white", "format": "{name}" },
    { "type": "gpu",    "key": "    Gráficos", "keyColor": "white", "hideType": "integrated", "format": "{name}" },
    { "type": "memory", "key": "     Memoria", "keyColor": "white" },
    { "type": "disk",   "key": "  Almacenaje", "keyColor": "white", "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "custom", "key": "  Escritorio", "keyColor": "white", "format": "Hyprland · kitty · zsh" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
